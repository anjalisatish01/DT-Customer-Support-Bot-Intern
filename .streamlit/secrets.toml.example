# Streamlit Cloud Secrets Configuration
# Copy this file to secrets.toml and fill in your actual values
# Or configure these secrets directly in Streamlit Cloud dashboard

# OpenAI API Key (Required)
OPENAI_API_KEY = "your_openai_api_key_here"

# Email Configuration (Optional - for escalation emails)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
SUPPORT_EMAIL_USER = "your_email@gmail.com"
SUPPORT_EMAIL_PASSWORD = "your_app_password"
SUPPORT_EMAIL_TO = "support@dispatchtrack.com"
